{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Swoos PUGs Balancer",
  "version": "1.3.2",
  "identifier": "com.stadiumbalancer.pugs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Swoos PUGs Balancer",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCODA2ODc5NjFGMTFGN0EKUldSNkgvRmhlV2lBMjgzMnIya0I3YXdON2I5Vk5xT3VodFR0dHpHdEZEanhCY0Rsbmd4cUxGd1gK",
      "endpoints": [
        "https://github.com/ShantingLiu/pugs-balancer-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
